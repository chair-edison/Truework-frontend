# ── 연결 방식 (셋 중 하나) ──────────────────────────────
# 1) 프록시(권장): 브라우저 → same-origin /api/v1 → Next 서버 → BACKEND_URL
NEXT_PUBLIC_API_PROXY=true
BACKEND_URL=https://<backend-host>
# Vercel Deployment Protection 이 켜진 백엔드라면 우회 토큰(서버 전용, 브라우저에 노출되지 않음)
VERCEL_PROTECTION_BYPASS=

# 2) 직접 호출: 백엔드 ALLOWED_ORIGINS 에 프런트 origin 등록 필요
# NEXT_PUBLIC_API_BASE_URL=https://<backend-host>

# 3) 둘 다 비우면 src/mocks 의 목 API (데모용)

# ── Supabase Auth ─────────────────────────────────────
# API 요청에 Supabase access token 을 Bearer 로 보냅니다. 목 모드에서는 비워두면 로컬 목 인증.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
